---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { publishedGuides, guidePath } from '../../lib/guides';
export async function getStaticPaths() { return (await publishedGuides()).map(guide => ({ params: { slug: guide.data.slug }, props: { guide } })); }
const { guide } = Astro.props;
const { Content } = await render(guide);
---
<BaseLayout title={guide.data.title} description={guide.data.description} path={guidePath(guide.data.slug)}><a href="/guides/">← All guides</a><article class="prose"><h1>{guide.data.title}</h1><p class="lede">{guide.data.description}</p><p>Updated <time datetime={guide.data.updatedAt.toISOString()}>{guide.data.updatedAt.toISOString().slice(0, 10)}</time></p><Content /><section aria-labelledby="sources"><h2 id="sources">Sources</h2><ul>{guide.data.sources.map(source => <li><a href={source.url}>{source.label}</a></li>)}</ul></section></article></BaseLayout>
